# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/foodrescue

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# CORS Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Optional Admin Registration Key (leave empty to allow only seeded/existing admins)
ADMIN_REGISTRATION_KEY=replace_with_admin_setup_key

# Optional Cloudinary Configuration (falls back to local /uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
